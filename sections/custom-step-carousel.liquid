      "id": "title",
      "label": "Title",
      "info": "Wrap text in **bold** to highlight it with the highlight color.",
      "default": "<p>Feeling good should not feel like another full-time job.</p>"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Simpele dagelijkse supplementen die passen in het leven dat je al hebt."
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "highlight_background_color",
