{%- liquid
  assign sizes = '100vw'
  assign widths = '600, 832, 1200, 1600, 1920, 2560, 3840'

  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif

  assign has_mobile_image = false
  if section.settings.image_mobile != blank
    assign has_mobile_image = true
  endif

  assign avatar_count = 0
  if section.settings.avatar_1 != blank
    assign avatar_count = avatar_count | plus: 1
  endif
  if section.settings.avatar_2 != blank
    assign avatar_count = avatar_count | plus: 1
  endif
  if section.settings.avatar_3 != blank
    assign avatar_count = avatar_count | plus: 1
  endif
  if section.settings.avatar_4 != blank
    assign avatar_count = avatar_count | plus: 1
  endif

  assign has_button_1 = false
  assign has_button_2 = false
  if section.settings.button_1_label != blank
    assign has_button_1 = true
  endif
  if section.settings.button_2_label != blank
    assign has_button_2 = true
  endif

  assign has_rating = false
  if section.settings.rating_text != blank
    assign has_rating = true
  endif
  assign has_clients = false
  if section.settings.clients_text != blank
    assign has_clients = true
  endif

  assign has_social_content = false
  if avatar_count > 0 or has_rating or has_clients
    assign has_social_content = true
  endif
  assign show_social_proof = false
  if section.settings.show_social_proof and has_social_content
    assign show_social_proof = true
  endif
-%}

<div
  id="CustomHero-{{ section.id }}"
  class="custom-hero color-{{ section.settings.color_scheme }}{% if section.settings.rounded_bottom %} custom-hero--rounded{% endif %}"
  style="
    --custom-hero-min-height: {%- if section.settings.section_height == 'full-screen' -%}100svh{%- elsif section.settings.section_height == 'custom' -%}{{ section.settings.section_height_custom }}svh{%- else -%}var(--section-height-{{ section.settings.section_height }}){%- endif -%};
    --custom-hero-overlay-color: {{ section.settings.overlay_color }};
    --custom-hero-highlight-bg: {{ section.settings.highlight_background_color }};
    --custom-hero-highlight-fg: {{ section.settings.highlight_text_color }};
    --custom-hero-text-align: {{ section.settings.text_alignment }};
    --custom-hero-corner-radius: {{ section.settings.corner_radius | default: 40 }}px;
  "
>
  <div class="custom-hero__media-grid" data-testid="custom-hero-media-wrapper">
    {%- if section.settings.toggle_overlay -%}
      <div class="custom-hero__overlay" aria-hidden="true"></div>
    {%- endif -%}

    {%- if section.settings.image != blank -%}
      {%- if has_mobile_image -%}
        <picture class="custom-hero__picture">
          <source
            media="(max-width: 749px)"
            srcset="
              {{ section.settings.image_mobile | image_url: width: 416 }} 416w,
              {{ section.settings.image_mobile | image_url: width: 600 }} 600w,
              {{ section.settings.image_mobile | image_url: width: 800 }} 800w,
              {{ section.settings.image_mobile | image_url: width: 1200 }} 1200w,
              {{ section.settings.image_mobile | image_url: width: 1600 }} 1600w
            "
            sizes="{{ sizes }}"
            width="{{ section.settings.image_mobile.width }}"
            height="{{ section.settings.image_mobile.height }}"
          >
          {{
            section.settings.image
            | image_url: width: 3840
            | image_tag:
              width: section.settings.image.width,
              widths: widths,
              height: section.settings.image.height,
              alt: section.settings.image.alt,
              class: 'custom-hero__media',
              sizes: sizes,
              fetchpriority: fetch_priority
          }}
        </picture>
      {%- else -%}
        {{
          section.settings.image
          | image_url: width: 3840
          | image_tag:
            width: section.settings.image.width,
            widths: widths,
            height: section.settings.image.height,
            alt: section.settings.image.alt,
            class: 'custom-hero__media',
            sizes: sizes,
            fetchpriority: fetch_priority
        }}
      {%- endif -%}
    {%- else -%}
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'custom-hero__media' }}
    {%- endif -%}
  </div>

  <div class="custom-hero__content section-content-wrapper {{ section.settings.section_width }}">
    {%- if section.settings.title != blank -%}
      <h1 class="custom-hero__title">
        {{ section.settings.title }}
      </h1>
    {%- endif -%}

    <div class="custom-hero__bottom">
      {%- if has_button_1 or has_button_2 -%}
        <div class="custom-hero__buttons">
          {%- if has_button_1 -%}
            <a
              href="{{ section.settings.button_1_link | default: '#' }}"
              class="custom-hero__button custom-hero__button--{{ section.settings.button_1_style }}"
              {% if section.settings.button_1_link == blank %}
                role="link" aria-disabled="true"
              {% endif %}
            >
              {{ section.settings.button_1_label }}
            </a>
          {%- endif -%}
          {%- if has_button_2 -%}
            <a
              href="{{ section.settings.button_2_link | default: '#' }}"
              class="custom-hero__button custom-hero__button--{{ section.settings.button_2_style }}"
              {% if section.settings.button_2_link == blank %}
                role="link" aria-disabled="true"
              {% endif %}
            >
              {{ section.settings.button_2_label }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if show_social_proof -%}
        <div class="custom-hero__social-proof">
          {%- if avatar_count > 0 -%}
            <ul class="custom-hero__avatars" aria-hidden="true">
              {%- for index in (1..4) -%}
                {%- assign avatar_key = 'avatar_' | append: index -%}
                {%- assign avatar = section.settings[avatar_key] -%}
                {%- if avatar != blank -%}
                  <li class="custom-hero__avatar">
                    {{
                      avatar
                      | image_url: width: 176
                      | image_tag:
                        width: 88,
                        height: 88,
                        widths: '88, 132, 176',
                        sizes: '88px',
                        alt: '',
                        loading: 'lazy',
                        class: 'custom-hero__avatar-img'
                    }}
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}

          {%- if has_rating or has_clients -%}
            <div class="custom-hero__social-proof-text">
              {%- if has_rating -%}
                <div class="custom-hero__rating">
                  {%- if section.settings.show_star -%}
                    <svg class="custom-hero__star" width="20" height="20" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false">
                      {%- render 'icon', icon: 'star' -%}
                    </svg>
                  {%- endif -%}
                  <span>{{ section.settings.rating_text }}</span>
                </div>
              {%- endif -%}
              {%- if has_clients -%}
                <p class="custom-hero__clients">{{ section.settings.clients_text }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .custom-hero {
    position: relative;
    display: grid;
    min-height: var(--custom-hero-min-height);
    overflow: hidden;
    isolation: isolate;
  }

  .custom-hero--rounded {
    border-bottom-left-radius: var(--custom-hero-corner-radius);
    border-bottom-right-radius: var(--custom-hero-corner-radius);
  }

  .custom-hero__media-grid {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .custom-hero__picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .custom-hero__media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    display: block;
  }

  .custom-hero__overlay {
    position: absolute;
    inset: 0;
    background-color: var(--custom-hero-overlay-color);
    z-index: 1;
    pointer-events: none;
  }

  .custom-hero__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: var(--custom-hero-text-align, flex-start);
    width: 100%;
    margin-inline: auto;
    padding-block: clamp(32px, 6vw, 80px);
    gap: clamp(24px, 4vw, 48px);
    min-height: var(--custom-hero-min-height);
  }

  .custom-hero__title {
    margin: 0;
    color: #fff;
    font-weight: 900;
    line-height: 0.95;
    letter-spacing: -0.01em;
    font-size: clamp(2.75rem, 11vw, 9rem);
    text-wrap: balance;
  }

  .custom-hero__title p,
  .custom-hero__title h1,
  .custom-hero__title h2 {
    margin: 0;
    line-height: inherit;
    font-weight: inherit;
    font-size: inherit;
  }

  /* Wrapping a word in **bold** in the title rich-text editor paints it with the highlight color. */
  .custom-hero__title strong {
    display: inline-block;
    background-color: var(--custom-hero-highlight-bg);
    color: var(--custom-hero-highlight-fg);
    padding-inline: 0.25em;
    font-weight: inherit;
  }

  .custom-hero__bottom {
    display: flex;
    flex-direction: column;
    gap: clamp(20px, 3vw, 32px);
    margin-block-start: auto;
    align-items: inherit;
    width: 100%;
  }

  .custom-hero__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .custom-hero__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 15px 25px;
    border-radius: 60px;
    font-size: 1.125rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.01em;
    text-decoration: none;
    transition: transform 120ms ease, background-color 120ms ease, color 120ms ease;
    cursor: pointer;
  }

  .custom-hero__button:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  .custom-hero__button--primary {
    background-color: var(--custom-hero-highlight-bg);
    color: var(--custom-hero-highlight-fg);
    border: 0.75px solid transparent;
  }

  .custom-hero__button--primary:hover {
    transform: translateY(-1px);
  }

  .custom-hero__button--secondary {
    background-color: rgba(255, 255, 255, 0.6);
    color: #331307;
    border: 0.75px solid rgba(255, 255, 255, 0.6);
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
  }

  .custom-hero__button--secondary:hover {
    background-color: rgba(255, 255, 255, 0.8);
    transform: translateY(-1px);
  }

  .custom-hero__social-proof {
    display: flex;
    align-items: center;
    gap: 16px;
    color: #fff;
  }

  .custom-hero__avatars {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
  }

  .custom-hero__avatar {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid rgba(255, 255, 255, 0.6);
    background-color: rgba(0, 0, 0, 0.1);
    flex-shrink: 0;
  }

  .custom-hero__avatar + .custom-hero__avatar {
    margin-inline-start: -22px;
  }

  .custom-hero__avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .custom-hero__social-proof-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
    line-height: 1.2;
  }

  .custom-hero__rating {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 1rem;
    font-weight: 500;
  }

  .custom-hero__star {
    width: 20px;
    height: 20px;
    color: #fff;
    flex-shrink: 0;
  }

  .custom-hero__clients {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 500;
    max-width: 22ch;
  }

  @media screen and (min-width: 750px) {
    .custom-hero__avatar {
      width: 72px;
      height: 72px;
    }
    .custom-hero__avatar + .custom-hero__avatar {
      margin-inline-start: -32px;
    }
    .custom-hero__social-proof {
      gap: 20px;
    }
    .custom-hero__rating { font-size: 1.125rem; }
    .custom-hero__clients { font-size: 1rem; }
    .custom-hero__button { font-size: 1.25rem; padding: 15px 28px; }
  }

  @media screen and (min-width: 1200px) {
    .custom-hero__avatar {
      width: 88px;
      height: 88px;
    }
    .custom-hero__avatar + .custom-hero__avatar {
      margin-inline-start: -50px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .custom-hero__button { transition: none; }
    .custom-hero__button:hover { transform: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Custom hero",
  "tag": "section",
  "class": "section-wrapper custom-hero-section",
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Title",
      "info": "Wrap text in **bold** to highlight it with the highlight color.",
      "default": "<p>For days that ask more</p>"
    },
    {
      "type": "color",
      "id": "highlight_background_color",
      "label": "Highlight / primary button background",
      "default": "#F7F262"
    },
    {
      "type": "color",
      "id": "highlight_text_color",
      "label": "Highlight / primary button text",
      "default": "#331307"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "Button 1 label",
      "default": "Shop all"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Button 1 link"
    },
    {
      "type": "select",
      "id": "button_1_style",
      "label": "Button 1 style",
      "options": [
        { "value": "primary", "label": "Primary (highlight color)" },
        { "value": "secondary", "label": "Secondary (frosted glass)" }
      ],
      "default": "primary"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Button 2 label",
      "default": "Bundle and save"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Button 2 link"
    },
    {
      "type": "select",
      "id": "button_2_style",
      "label": "Button 2 style",
      "options": [
        { "value": "primary", "label": "Primary (highlight color)" },
        { "value": "secondary", "label": "Secondary (frosted glass)" }
      ],
      "default": "secondary"
    },
    {
      "type": "header",
      "content": "Social proof"
    },
    {
      "type": "checkbox",
      "id": "show_social_proof",
      "label": "Show social proof",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "avatar_1",
      "label": "Avatar 1"
    },
    {
      "type": "image_picker",
      "id": "avatar_2",
      "label": "Avatar 2"
    },
    {
      "type": "image_picker",
      "id": "avatar_3",
      "label": "Avatar 3"
    },
    {
      "type": "image_picker",
      "id": "avatar_4",
      "label": "Avatar 4"
    },
    {
      "type": "checkbox",
      "id": "show_star",
      "label": "Show star icon next to rating",
      "default": true
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating text",
      "default": "(4.9/5)"
    },
    {
      "type": "text",
      "id": "clients_text",
      "label": "Clients text",
      "default": "Happily used by 300+ clients"
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Background image (mobile)",
      "info": "Optional. Falls back to the desktop image."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    {
      "type": "select",
      "id": "section_height",
      "label": "Height",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "full-screen", "label": "Full screen" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "large"
    },
    {
      "type": "range",
      "id": "section_height_custom",
      "label": "Custom height",
      "min": 30,
      "max": 100,
      "step": 1,
      "default": 85,
      "unit": "%",
      "visible_if": "{{ section.settings.section_height == 'custom' }}"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Content alignment",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ],
      "default": "flex-start"
    },
    {
      "type": "checkbox",
      "id": "rounded_bottom",
      "label": "Rounded bottom corners",
      "default": true
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 64,
      "step": 4,
      "default": 40,
      "unit": "px",
      "visible_if": "{{ section.settings.rounded_bottom }}"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "toggle_overlay",
      "label": "Show media overlay",
      "default": false
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "alpha": true,
      "default": "#00000040",
      "visible_if": "{{ section.settings.toggle_overlay }}"
    }
  ],
  "presets": [
    {
      "name": "Custom hero",
      "category": "Banners",
      "settings": {
        "section_height": "large",
        "text_alignment": "flex-start",
        "color_scheme": "scheme-1",
        "rounded_bottom": true,
        "corner_radius": 40,
        "toggle_overlay": false
      }
    }
  ]
}
{% endschema %}
