{% doc %}
  @prompt
    Add an "Add to Cart" button to the testimonial card block in the testimonials section. The button should allow linking to a specific product and add it to the cart when clicked, styled to match the existing theme design.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-testimonial-card-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-testimonial-card__container-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    padding: {{ block.settings.padding }}px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    height: 100%;
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
  }

  .ai-testimonial-card__header-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .ai-testimonial-card__avatar-{{ ai_gen_id }} {
    width: {{ block.settings.avatar_size }}px;
    height: {{ block.settings.avatar_size }}px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    background-color: #f5f5f5;
  }

  .ai-testimonial-card__avatar-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-testimonial-card__avatar-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f5f5f5;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-testimonial-card__avatar-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-testimonial-card__author-info-{{ ai_gen_id }} {
    flex-grow: 1;
  }

  .ai-testimonial-card__author-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.author_name_size }}px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    margin: 0 0 4px 0;
  }

  .ai-testimonial-card__author-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.author_title_size }}px;
    color: {{ block.settings.text_color }};
    opacity: 0.7;
    margin: 0;
  }

  .ai-testimonial-card__rating-{{ ai_gen_id }} {
    display: flex;
    gap: 4px;
  }

  .ai-testimonial-card__star-{{ ai_gen_id }} {
    width: {{ block.settings.star_size }}px;
    height: {{ block.settings.star_size }}px;
    color: {{ block.settings.star_color }};
  }

  .ai-testimonial-card__star-{{ ai_gen_id }}--empty {
    opacity: 0.2;
  }

  .ai-testimonial-card__content-{{ ai_gen_id }} {
    flex-grow: 1;
  }

  .ai-testimonial-card__quote-{{ ai_gen_id }} {
    font-size: {{ block.settings.quote_size }}px;
    line-height: 1.6;
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  .ai-testimonial-card__footer-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ai-testimonial-card__product-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px;
    background-color: {{ block.settings.product_bg_color }};
    border-radius: 8px;
  }

  .ai-testimonial-card__product-image-{{ ai_gen_id }} {
    width: 60px;
    height: 60px;
    flex-shrink: 0;
    border-radius: 4px;
    overflow: hidden;
    background-color: #f5f5f5;
  }

  .ai-testimonial-card__product-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-testimonial-card__product-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f5f5f5;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-testimonial-card__product-image-placeholder-{{ ai_gen_id }} svg {
    width: 70%;
    height: 70%;
    opacity: 0.3;
  }

  .ai-testimonial-card__product-info-{{ ai_gen_id }} {
    flex-grow: 1;
    min-width: 0;
  }

  .ai-testimonial-card__product-title-{{ ai_gen_id }} {
    font-size: 14px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    margin: 0 0 4px 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ai-testimonial-card__product-price-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.text_color }};
    opacity: 0.8;
    margin: 0;
  }

  .ai-testimonial-card__add-to-cart-{{ ai_gen_id }} {
    width: 100%;
    padding: 12px 24px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    text-align: center;
  }

  .ai-testimonial-card__add-to-cart-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
  }

  .ai-testimonial-card__add-to-cart-{{ ai_gen_id }}:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .ai-testimonial-card__empty-state-{{ ai_gen_id }} {
    padding: 20px;
    text-align: center;
    color: #999;
    font-size: 14px;
    font-style: italic;
  }

  @media screen and (max-width: 749px) {
    .ai-testimonial-card__container-{{ ai_gen_id }} {
      padding: {{ block.settings.padding | times: 0.75 }}px;
    }
  }
{% endstyle %}

<testimonial-card-{{ ai_gen_id }}
  class="ai-testimonial-card-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-testimonial-card__container-{{ ai_gen_id }}">
    <div class="ai-testimonial-card__header-{{ ai_gen_id }}">
      <div class="ai-testimonial-card__avatar-{{ ai_gen_id }}">
        {% if block.settings.author_image %}
          <img
            src="{{ block.settings.author_image | image_url: width: 200 }}"
            alt="{{ block.settings.author_name | escape }}"
            loading="lazy"
            width="200"
            height="200"
          >
        {% else %}
          <div class="ai-testimonial-card__avatar-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>

      <div class="ai-testimonial-card__author-info-{{ ai_gen_id }}">
        {% if block.settings.author_name != blank %}
          <h3 class="ai-testimonial-card__author-name-{{ ai_gen_id }}">{{ block.settings.author_name }}</h3>
        {% endif %}
        {% if block.settings.author_title != blank %}
          <p class="ai-testimonial-card__author-title-{{ ai_gen_id }}">{{ block.settings.author_title }}</p>
        {% endif %}
      </div>
    </div>

    {% if block.settings.show_rating %}
      <div class="ai-testimonial-card__rating-{{ ai_gen_id }}">
        {% for i in (1..5) %}
          <svg
            class="ai-testimonial-card__star-{{ ai_gen_id }} {% if i > block.settings.rating %}ai-testimonial-card__star-{{ ai_gen_id }}--empty{% endif %}"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
          </svg>
        {% endfor %}
      </div>
    {% endif %}

    <div class="ai-testimonial-card__content-{{ ai_gen_id }}">
      {% if block.settings.quote != blank %}
        <div class="ai-testimonial-card__quote-{{ ai_gen_id }}">{{ block.settings.quote }}</div>
      {% endif %}
    </div>

    <div class="ai-testimonial-card__footer-{{ ai_gen_id }}">
      {% if block.settings.product != blank %}
        <div class="ai-testimonial-card__product-{{ ai_gen_id }}">
          <div class="ai-testimonial-card__product-image-{{ ai_gen_id }}">
            {% if block.settings.product.featured_image %}
              <img
                src="{{ block.settings.product.featured_image | image_url: width: 120 }}"
                alt="{{ block.settings.product.featured_image.alt | escape }}"
                loading="lazy"
                width="120"
                height="120"
              >
            {% else %}
              <div class="ai-testimonial-card__product-image-placeholder-{{ ai_gen_id }}">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>

          <div class="ai-testimonial-card__product-info-{{ ai_gen_id }}">
            <h4 class="ai-testimonial-card__product-title-{{ ai_gen_id }}">{{ block.settings.product.title }}</h4>
            <p class="ai-testimonial-card__product-price-{{ ai_gen_id }}">{{ block.settings.product.price | money }}</p>
          </div>
        </div>

        <button
          class="ai-testimonial-card__add-to-cart-{{ ai_gen_id }}"
          data-product-id="{{ block.settings.product.id }}"
          data-variant-id="{{ block.settings.product.selected_or_first_available_variant.id }}"
          aria-label="Add {{ block.settings.product.title }} to cart"
        >
          {{ block.settings.button_text }}
        </button>
      {% else %}
        <div class="ai-testimonial-card__empty-state-{{ ai_gen_id }}">
          Next, select a product to feature
        </div>
      {% endif %}
    </div>
  </div>
</testimonial-card-{{ ai_gen_id }}>

<script>
  (function() {
    class TestimonialCard{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.button = this.querySelector('.ai-testimonial-card__add-to-cart-{{ ai_gen_id }}');
        if (this.button) {
          this.button.addEventListener('click', this.handleAddToCart.bind(this));
        }
      }

      async handleAddToCart(event) {
        event.preventDefault();
        
        const button = event.target;
        const variantId = button.dataset.variantId;
        
        if (!variantId) return;

        button.disabled = true;
        const originalText = button.textContent;
        button.textContent = '{{ block.settings.adding_text }}';

        try {
          const response = await fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              items: [{
                id: variantId,
                quantity: 1
              }]
            })
          });

          if (!response.ok) {
            throw new Error('Failed to add to cart');
          }

          button.textContent = '{{ block.settings.added_text }}';

          setTimeout(() => {
            button.textContent = originalText;
            button.disabled = false;
          }, 2000);

          document.dispatchEvent(new CustomEvent('cart:refresh'));
          
          if (window.theme && window.theme.cart) {
            window.theme.cart.refresh();
          }

        } catch (error) {
          console.error('Error adding to cart:', error);
          button.textContent = originalText;
          button.disabled = false;
        }
      }
    }

    customElements.define('testimonial-card-{{ ai_gen_id }}', TestimonialCard{{ ai_gen_id }});
  })();
</script>

